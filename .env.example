ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Generate a secure string for JWT_SECRET (e.g. openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_string_change_me
KEY_NAME="My APT Repository"
KEY_EMAIL="apt@example.com"

# --- Database Configuration (Optional) ---
# By default Aptify uses SQLite. 
# Uncomment the lines below to use MySQL instead.
# DB_TYPE=mysql
# DB_DSN=aptify:aptifypass@tcp(db:3306)/aptify?parseTime=true
