services:
  aptify:
    build:
      context: .
      args:
        VERSION: ${VERSION:-dev}
    ports:
      - "8080:8080"
    volumes:
      - apt-data:/data
    environment:
      - DATA_DIR=/data
      - ADDR=:8080
      - ADMIN_USERNAME=${ADMIN_USERNAME:-admin}
      - ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin123}
      # Generate the key using openssl rand -hex 32
      - JWT_SECRET=${JWT_SECRET:-YOUR_GENERATED_STRING_HERE}
      - KEY_NAME=${KEY_NAME:-"APT Repository"}
      - KEY_EMAIL=${KEY_EMAIL:-"abc@example.com"}
      # To use MySQL, uncomment the lines below and the db service:
      # - DB_TYPE=mysql
      # - DB_DSN=aptify:aptifypass@tcp(db:3306)/aptify?parseTime=true
    restart: unless-stopped
    # depends_on:
    #   - db

  # Uncomment to use MySQL instead of the default SQLite
  # db:
  #   image: mysql:8
  #   environment:
  #     - MYSQL_DATABASE=aptify
  #     - MYSQL_USER=aptify
  #     - MYSQL_PASSWORD=aptifypass
  #     - MYSQL_ROOT_PASSWORD=rootpass
  #   ports:
  #     - "3306:3306"
  #   volumes:
  #     - mysql-data:/var/lib/mysql

volumes:
  apt-data:
  # mysql-data:
